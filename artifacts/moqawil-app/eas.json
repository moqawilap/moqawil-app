{
  "cli": {
    "version": ">= 14.7.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "pnpm": "10.26.1"
    },
    "production": {
      "autoIncrement": true,
      "developmentClient": false,
      "distribution": "store",
      "environment": "production",
      "pnpm": "10.26.1",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "production",
      "pnpm": "10.26.1",
      "android": {
        "image": "latest",
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}